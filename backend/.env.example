NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/synapseai
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_DOMAIN=

# AI_MODE: live | mock. "mock" uses clearly-labelled stub responses (no network).
AI_MODE=live

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated; used in order when the main model is out of quota or overloaded.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Evidence retrieval: none | tavily
EVIDENCE_PROVIDER=none
TAVILY_API_KEY=
EVIDENCE_MAX_RESULTS=5

AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4096
# Extra tokens Gemini may spend reasoning before it answers (0 disables thinking on Flash models).
GEMINI_THINKING_BUDGET=1024
# Hard ceiling on refinement passes per run (each pass is one Gemini call).
MAX_REFINEMENT_ITERATIONS=8
MAX_CONCURRENT_RUNS=3

# Proxy hops in front of the API (for per-user rate limits). 2 on Render/Heroku-style hosts behind the Next.js proxy.
TRUST_PROXY=
